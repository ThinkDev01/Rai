# Rai v2 frontend env — copy to .env and fill in.
# NEXT_PUBLIC_ prefix is MANDATORY — Next only exposes those to the browser.
# Cognito identifiers first; region + URLs (flip per deploy, then REBUILD) at the bottom.

# ── Auth provider ────────────────────────────────────────────────────────────
# custom/manual = backend DB-backed auth (DEFAULT) — no Cognito needed.
# aws           = Cognito — needs the NEXT_PUBLIC_COGNITO_* values below.
NEXT_PUBLIC_AUTH_PROVIDER=custom

NEXT_PUBLIC_COGNITO_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=

# Region + URLs — flip per deploy then REBUILD; no trailing slash. OAuth URLs must match the Cognito app client lists.
NEXT_PUBLIC_COGNITO_REGION=ap-south-2
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_OAUTH_SIGNIN_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_OAUTH_SIGNOUT_URL=http://localhost:3000/
