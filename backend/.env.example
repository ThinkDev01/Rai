# Rai v2 backend env — copy to .env and fill in. Never commit .env.
# Connections/secrets first (DB, AWS, Cognito, Razorpay, FCM); app settings + URLs at the bottom.

# Database — DB_HOST drives SSL: localhost/127.0.0.1 = plain TCP, else SSL on.
DB_HOST=localhost
DB_PORT=5432
DB_USER=rai_user
DB_PASSWORD=rai_password
DB_NAME=rai_v2

# AWS credentials for Cognito admin + SES.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 uploads bucket (attachments). Local placeholder until real bucket provisioned.
S3_BUCKET=

# Cognito user pool — backend verifies tokens against these.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Razorpay (payments) — ALL FOUR REQUIRED; boot fails if any is missing.
# Use rzp_test_* for local/staging, rzp_live_* only in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# Firebase Admin (FCM push) — OPTIONAL. Base64 of service-account JSON; unset = push disabled.
FIREBASE_SERVICE_ACCOUNT=

# Secret for internal job endpoint (POST /api/v1/internal/jobs?job=<name>), sent by
# EventBridge in the x-internal-secret header. Long + random; same value both sides.
INTERNAL_JOB_SECRET=

# App settings — listen port, log level, env marker (dev|prod), AWS region, SES sender, feedback inbox.
PORT=4000
LOG_LEVEL=info
ENVIRONMENT=dev
AWS_REGION=ap-south-2

# ── Auth provider ────────────────────────────────────────────────────────────
# custom/manual = DB-backed auth (DEFAULT; needs JWT_SECRET, no AWS required)
# aws           = Cognito (needs AWS_REGION + AWS creds + COGNITO_* below)
AUTH_PROVIDER=custom

# Required when AUTH_PROVIDER=custom — HS256 signing secret (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Email — Resend (free tier). RESEND_FROM_EMAIL falls back to SES_FROM_EMAIL.
# For testing you can use the Resend onboarding sender (onboarding@resend.dev),
# but for real sends verify a domain in Resend and use an address on it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cron jobs: internal = run jobs in-process via the local scheduler (DEFAULT —
# local/dev runs); aws = EventBridge calls POST /api/v1/internal/jobs.
JOB_RUNNER=internal

# SES sender + feedback inbox (aws mode / legacy).
SES_FROM_EMAIL=
SUPPORT_EMAIL=

# URLs — flip per deploy (localhost → real domain); no trailing slash.
CORS_ORIGIN=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=
