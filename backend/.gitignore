# ────────────────────────────────────────────────────────────────────────────
# Rai backend — git ignore rules
# ────────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/

# Build output
dist/
build/

# Environment secrets — actual env files NEVER committed.
# Templates (.env.example, .env.test.example) ARE safe to commit; NOT here.
.env
.env.local
.env.staging
.env.production
.env.test

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pino-*.log

# Test coverage
coverage/
*.lcov

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# Local Postgres data (in case anyone runs docker-compose from here)
postgres_data/

scripts/seed-local.ts
