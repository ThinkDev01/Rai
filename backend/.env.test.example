# Test DB config — copy to `.env.test`. Tests load this FIRST so they NEVER use
# the staging RDS in .env. DB_HOST must be a local host or the suite refuses to
# run (safety guard in tests/setup.ts). The suite DROPs/CREATEs rai_test_db.
DB_HOST=localhost
DB_PORT=5432
DB_USER=rai_user
DB_PASSWORD=rai_password
DB_NAME=rai_test_db
