{
  "name": "rai-backend",
  "version": "1.0.0",
  "description": "Rai — Jira alternative backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "tsx server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "purge:orgs": "tsx scripts/purge-orgs.ts",
    "billing:sweep": "tsx scripts/billing-sweep.ts",
    "jobs:sprint-autostart": "tsx jobs/sprint-autostart.job.ts",
    "jobs:invite-cleanup": "tsx jobs/invite-cleanup.job.ts",
    "jobs:attachment-cleanup": "tsx jobs/attachment-cleanup.job.ts",
    "seed:trial-ended": "tsx scripts/seed-trial-ended.ts",
    "billing:test-notify": "tsx scripts/billing-test-notify.ts",
    "seed:local": "tsx scripts/seed-local.ts",
    "seed:quicksearch": "tsx scripts/seed-quicksearch.ts",
    "seed:hydra": "tsx scripts/seed-hydra.ts",
    "seed:hydra:clean": "tsx scripts/seed-hydra-cleanup.ts",
    "test:push": "tsx scripts/test-push.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verbose": "vitest run --reporter=verbose",
    "lockcheck": "node scripts/verify-lock.mjs",
    "lock:fix": "node scripts/fix-lock.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.8",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1050.0",
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/client-sesv2": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1050.0",
    "aws-jwt-verify": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "razorpay": "^2.9.6",
    "undici": "^8.5.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.8"
  }
}
